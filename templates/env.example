# Transkreebatoriya — пример конфигурации через переменные окружения.
# Установка: install.ps1 / install.sh копируют этот файл в .env (не перезаписывая
# существующий). Все параметры имеют разумные дефолты — .env необязателен для запуска.

# ── Whisper ───────────────────────────────────────────────────────────────────
# Варианты: tiny | base | small | medium | large-v3
# Чем больше модель — тем точнее, но медленнее и требует больше RAM/VRAM.
WHISPER_MODEL_NAME=base

# Устройство вычислений: auto | cpu | cuda
# auto → CUDA если доступно, иначе CPU
WHISPER_DEVICE=auto

# Язык распознавания речи (ISO-639-1): ru | en | de | ...
# auto → автоопределение whisper (чуть медленнее и менее стабильно)
WHISPER_LANGUAGE=ru

# ── ffmpeg ────────────────────────────────────────────────────────────────────
# Путь к ffmpeg. Если ffmpeg в PATH — менять не нужно.
FFMPEG_PATH=ffmpeg

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_API_URL=http://localhost:11434/api/generate

# Модель для постобработки транскрипции.
# Варианты (по убыванию качества / возрастанию скорости):
#   qwen3:4b      — качество ★★★★, скорость ★★
#   qwen2.5:1.5b  — качество ★★★,  скорость ★★★★
#   llama3.2:1b   — качество ★★,   скорость ★★★★★
# Для этого ноутбука рекомендована qwen2.5:1.5b.
# Опционально: alias transkreebatoriya-qwen25-cpu с зашитыми параметрами
# (install-скрипт рендерит Modelfile из templates/ и создаёт его).
OLLAMA_MODEL=qwen2.5:1.5b

# Runtime options для Ollama / llama.cpp backend
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=768
OLLAMA_TEMPERATURE=0.15
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=30
OLLAMA_MIN_P=0.05
OLLAMA_REPEAT_LAST_N=128
OLLAMA_REPEAT_PENALTY=1.08

# Максимум символов в одном чанке постобработки
POSTPROCESS_CHUNK_CHARS=1800

# Сколько чанков обрабатывать параллельно.
# На i5-1135G7 + 16 GB RAM безопасный дефолт — 1.
POSTPROCESS_CONCURRENCY=1

# Таймаут одного запроса к Ollama в секундах (на один чанк).
# Увеличьте если Ollama работает медленно (тяжёлая модель, слабый CPU).
OLLAMA_TIMEOUT=1800

# ── Лимиты файлов ─────────────────────────────────────────────────────────────
# Максимальный размер загружаемого файла в ГБ
MAX_FILE_SIZE_GB=6

# ── Задачи ────────────────────────────────────────────────────────────────────
# Сколько часов хранить завершённые задачи (результаты) в памяти
TASK_TTL_HOURS=24

# ── Сервер ────────────────────────────────────────────────────────────────────
APP_HOST=localhost
APP_PORT=8001

# ── Hugging Face (опционально) ────────────────────────────────────────────────
# Токен для ускоренной загрузки моделей с Hugging Face Hub.
# Получить: huggingface.co → Settings → Access Tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
